# Docker build context for packages/frontendmu-adonis/Dockerfile.
# Only the adonis package and the workspace manifests are needed.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.npmrc
!packages/frontendmu-adonis
!packages/frontendmu-astro/package.json
!packages/frontendmu-nuxt/package.json
!packages/frontendmu-data/package.json

packages/frontendmu-adonis/node_modules
packages/frontendmu-adonis/build
packages/frontendmu-adonis/tmp
packages/frontendmu-adonis/.adonisjs
packages/frontendmu-adonis/public/assets
packages/frontendmu-adonis/playwright-report
packages/frontendmu-adonis/database/backups
packages/frontendmu-adonis/database/exports
packages/frontendmu-adonis/.env
packages/frontendmu-adonis/.env.*
!packages/frontendmu-adonis/.env.test
