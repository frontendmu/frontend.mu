TZ=UTC
PORT=3334
HOST=localhost
LOG_LEVEL=silent
APP_KEY=test-app-key-not-used-outside-the-test-runner
NODE_ENV=test
SESSION_DRIVER=cookie
APP_URL=http://localhost:3334

# A fresh copy of database/db.local.sqlite3 is made here before every run.
DB_DATABASE=tmp/db.test.sqlite3

FEATURE_RSVP_PAST_EVENTS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

DRIVE_DISK=fs
DEBUGBAR_ENABLED=false
