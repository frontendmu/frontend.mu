TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
# Fixed test-only key — not a secret, safe to commit (used only for the test suite).
APP_KEY=UDNjZk1lNjhaeWZaYU1CVzlWX3ZOc0poNzZWQVBQdWQ=
NODE_ENV=test
SESSION_DRIVER=memory
APP_URL=http://localhost:3333

# Database (SQLite) — tests write inside a transaction that's rolled back after
# each test (see tests/bootstrap.ts / testUtils.db().withGlobalTransaction()),
# so it's safe to point this at the same dev seed database.
DB_DATABASE=database/db.local.sqlite3

# Feature Flags
FEATURE_RSVP_PAST_EVENTS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_DISK=fs
