TZ=UTC
PORT=3333
HOST=localhost
LOG_LEVEL=info
# Fixed test-only key — not a secret, safe to commit (used only for the test suite).
APP_KEY=UDNjZk1lNjhaeWZaYU1CVzlWX3ZOc0poNzZWQVBQdWQ=
NODE_ENV=test
SESSION_DRIVER=memory
APP_URL=http://localhost:3333

# Database (SQLite) — isolated test database, separate from dev and production.
# The schema and seed data are created automatically before tests run (see
# tests/bootstrap.ts / testUtils.db().migrate() + .seed()). Writes inside each
# test are wrapped in a transaction that's rolled back (withGlobalTransaction()).
DB_DATABASE=database/db.test.sqlite3

# Feature Flags
FEATURE_RSVP_PAST_EVENTS=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DRIVE_DISK=fs
