{
  "name": "frontendmu-adonis",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "license": "UNLICENSED",
  "scripts": {
    "start": "node bin/server.js",
    "build": "node ace build",
    "dev": "node ace serve --hmr",
    "test": "node ace test",
    "test:a11y": "playwright test --config=playwright.a11y.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "codegen": "node ace codegen",
    "typecheck": "tsc --noEmit",
    "db:sync-local-meetup-details": "node database/scripts/sync_local_sqlite_meetup_details.mjs",
    "clean:ports": "lsof -t -i:3333 | xargs kill && lsof -t -i:24678 | xargs kill",
    "verify:build": "node scripts/verify_build_output.mjs"
  },
  "imports": {
    "#generated/*": "./.adonisjs/server/*.js",
    "#dtos/*": "./app/dtos/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#models/*": "./app/models/*.js",
    "#mails/*": "./app/mails/*.js",
    "#services/*": "./app/services/*.js",
    "#listeners/*": "./app/listeners/*.js",
    "#events/*": "./app/events/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#validators/*": "./app/validators/*.js",
    "#providers/*": "./providers/*.js",
    "#policies/*": "./app/policies/*.js",
    "#abilities/*": "./app/abilities/*.js",
    "#transformers/*": "./app/transformers/*.js",
    "#utils/*": "./app/utils/*.js",
    "#database/*": "./database/*.js",
    "#tests/*": "./tests/*.js",
    "#start/*": "./start/*.js",
    "#config/*": "./config/*.js"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.5.1",
    "@adonisjs/eslint-config": "^3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@japa/api-client": "^3.2.1",
    "@japa/assert": "^4.2.0",
    "@japa/plugin-adonisjs": "^5.2.0",
    "@japa/runner": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@poppinss/ts-exec": "^1.4.4",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "@types/phc__format": "^1.0.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "autoprefixer": "^10.5.5",
    "axe-core": "^4.13.0",
    "eslint": "^10.10.0",
    "hot-hook": "^1.0.0",
    "pino-pretty": "^13.0.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "youch": "^4.1.1"
  },
  "dependencies": {
    "@adonisjs/ally": "^6.3.0",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/bouncer": "^4.0.1",
    "@adonisjs/core": "^7.5.0",
    "@adonisjs/cors": "^3.0.0",
    "@adonisjs/drive": "^4.0.0",
    "@adonisjs/inertia": "^5.0.1",
    "@adonisjs/lucid": "^22.4.2",
    "@adonisjs/session": "^8.1.0",
    "@adonisjs/shield": "^9.0.0",
    "@adonisjs/static": "^2.0.1",
    "@adonisjs/vite": "^6.0.2",
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "@eznix/adonisjs-debugbar": "^0.1.4",
    "@inertiajs/vue3": "^3.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vinejs/vine": "^4.4.0",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.4.15",
    "edge.js": "^6.5.1",
    "luxon": "^3.7.2",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "vue": "^3.5.42"
  },
  "hotHook": {
    "boundaries": [
      "./app/controllers/**/*.ts",
      "./app/middleware/*.ts"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
